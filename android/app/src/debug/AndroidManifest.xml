<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks cleartext HTTP by default, which would stop debug
         builds reaching a local backend over http://<lan-ip>:8000. This lives in
         the debug manifest only, so release builds keep the secure default and
         must talk to an HTTPS endpoint. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
